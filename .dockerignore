# Build context for the frontend image is the repository root: it needs .qoder/skills and
# scripts/stage_skill.py to assemble public/skill. Everything bulky or local stays out.

.git/
data/
**/__pycache__/
**/.DS_Store
*.qoder.site

backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/e2e/
frontend/playwright.config.ts
frontend/spike_wasm.mjs

# Staged browser CPython for the static export; the server deployment does not use it.
frontend/public/wasm/
