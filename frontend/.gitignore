# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# Staged browser CPython, produced by `scripts/stage_wasm.py` (or `make sites`).
#
# ~15 MiB of interpreter, wheels and zipped backend source. Regenerable from two inputs the
# repository does track -- the pyodide devDependency and backend/app -- and tracking it would put a
# second copy of every backend module in git history while making every clone download an interpreter.
/public/wasm/

# The Skill download package, produced by `scripts/stage_skill.py`. Same argument as above: it is a
# copy of files this repository already tracks, rebuilt on every `make sites`.
/public/skill/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
