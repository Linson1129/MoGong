# MoGong repository ignores.
#
# One file at the root rather than one per project, because the two halves share `fixtures/`,
# `data/`, and the build artefacts below. The per-project `.gitignore` files are still honoured
# for their own artefacts.

# Build output
frontend/.next/
frontend/out/
backend/dist/
backend/build/

# Dependencies
frontend/node_modules/
backend/.venv/
backend/.mypy_cache/

# Test artefacts
frontend/coverage/
backend/.pytest_cache/
backend/.coverage
backend/.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Python
__pycache__/
*.pyc
backend/mogong_backend.egg-info/

# Environment
.env
.env.local

# Qoder Sites descriptor.
#
# It records this machine's project/site/action bindings for one directory and is rewritten by
# every publication. It describes a registration, not the project, so it stays local.
*.qoder.site

# Drawings and compile artefacts.
#
# These are the user's data, not the project's source. A layout file records whatever that person
# happened to draw, including the notes on it, so tracking them would publish private work through
# a public repository. The directories are recreated on startup by Settings.ensure_directories(),
# which is why nothing needs a .gitkeep here.
data/
